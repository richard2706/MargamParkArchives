<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MargamParkArchives.Windows.UI.SharedViews.ArtefactSearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MargamParkArchives.Windows.UI.SharedViews"
    xmlns:tableview="using:WinUI.TableView"
    xmlns:converters="using:CommunityToolkit.WinUI.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              HorizontalAlignment="Center"
              Margin="10,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     HorizontalAlignment="Stretch"
                     Width="500"
                     Margin="0,0,10,0"
                     PlaceholderText="Search artefacts..."/>
            <Button Grid.Column="1"
                    MinWidth="80"
                    Style="{ThemeResource AccentButtonStyle}"
                    Content="Search"
                    Command="{x:Bind _viewModel.SearchCommand}"/>
        </Grid>

        <!-- Results row -->
        <Grid Grid.Row="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Margin="10,5"
                        HorizontalAlignment="Center"
                        Visibility="{x:Bind _viewModel.ShowSearchPrompt, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                Use the tools above to search the archives
            </TextBlock>

            <ProgressRing IsActive="True" Visibility="{x:Bind _viewModel.ShowSearchLoadingIndicator, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

            <tableview:TableView x:Name="ArtefactTableView"
                                 Height="Auto"
                                 ItemsSource="{x:Bind _viewModel.Artefacts, Mode=OneWay}"
                                 IsReadOnly="True"
                                 SelectionUnit="Row"
                                 Visibility="{x:Bind _viewModel.ShowResultsTable, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </Grid>
    </Grid>
</Page>
