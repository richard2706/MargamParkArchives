<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="MargamParkArchives.Windows.UI.SharedViews.ArtefactSearchPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MargamParkArchives.Windows.UI.SharedViews"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0"
              HorizontalAlignment="Center"
              Margin="10,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     HorizontalAlignment="Stretch"
                     Width="500"
                     Margin="0,0,10,0"
                     PlaceholderText="Search artefacts..."/>
            <Button Grid.Column="1"
                    MinWidth="80"
                    Style="{ThemeResource AccentButtonStyle}"
                    Content="Search" />
        </Grid>

        <!-- Results row -->
        <Grid>
            <!--<TextBlock Grid.Row="1" Margin="10,5">Search results will appear here.</TextBlock>-->
            <ItemsView ItemsSource="{x:Bind _viewModel.Artefacts, Mode=OneWay}">
                <ItemsView.Layout>
                    <StackLayout Spacing="5"/>
                </ItemsView.Layout>
            </ItemsView>
        </Grid>
    </Grid>
</Page>
