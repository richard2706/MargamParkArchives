<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MargamParkArchives.AdminConsole.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MargamParkArchives.AdminConsole"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Margam Park Archives Admin Console">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid Loaded="RootGrid_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title bar -->
            <RowDefinition Height="*"/> <!-- NavigationView for pages contained in a frame -->
            <RowDefinition Height="Auto"/> <!-- Info bar -->
        </Grid.RowDefinitions>
        
        <TitleBar x:Name="AppTitleBar"
                  Grid.Row="0"
                  Title="Margam Park Archives Admin Console"
                  IsBackButtonVisible="True"
                  IsBackButtonEnabled="{x:Bind _navigationService.CanGoBack(), Mode=OneWay}">
        </TitleBar>

        <NavigationView Grid.Row="1"
                        PaneDisplayMode="Top"
                        IsSettingsVisible="False"
                        SelectionChanged="NavigationView_SelectionChanged"
                        IsBackButtonVisible="Collapsed">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Browse Artefacts" IsSelected="True" Tag="{x:Bind local:NavigationPage.ArtefactSearch}"/>
                <NavigationViewItem Content="Import Data" Tag="{x:Bind local:NavigationPage.Import}"/>
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame"/>
        </NavigationView>
    </Grid>
</Window>
